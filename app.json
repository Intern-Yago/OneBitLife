{
  "expo": {
    "name": "OneBitLife",
    "slug": "OneBitLife",
    "owner": "syri_cotocs",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./src/assets/icons/logo1.png",
    "platforms": [
      "android",
      "ios"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "com.internyago.OneBitLife",
      "buildNumber": "1.1.4",
      "supportsTablet": true
    },
    "android": {
      "package": "com.internyago.OneBitLife",
      "versionCode": 21,
      "allowBackup": false,
      "backgroundColor": "#0A0E17",
      "splash": {
        "image": "./src/assets/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#0A0E17"
      },
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icons/logo1.png",
        "backgroundColor": "#0A0E17"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./src/assets/icons/logo1.png",
          "color": "#90B7F3"
        }
      ]
    ],
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0A0E17"
    },
    "web": {
      "favicon": "./src/assets/icons/logo1.png"
    },
    "extra": {
      "eas": {
        "projectId": "99890263-1e92-4450-b0fe-9a389d50e0a0"
      }
    }
  }
}
